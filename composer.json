{
    "name": "nivek1110/extendredirect",
    "type": "typo3-cms-extension",
    "description": "Self-maintaining redirects for TYPO3: health check, automatic disabling of broken redirects, page delete/hide protection, CSV import and a disable log.",
    "keywords": [
        "TYPO3",
        "extension",
        "redirects",
        "health check"
    ],
    "authors": [
        {
            "name": "nivek1110",
            "role": "Developer"
        }
    ],
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-redirects": "^13.4 || ^14.3",
        "typo3/cms-scheduler": "^13.4 || ^14.3"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.2 || ^9.0",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/cms-setup": "^13.4 || ^14.3",
        "typo3/cms-lowlevel": "^13.4 || ^14.3",
        "helhum/typo3-console": "^9.0",
        "phpunit/phpunit": "^12.5",
        "friendsofphp/php-cs-fixer": "^3.51",
        "phpstan/phpstan": "^2.1",
        "saschaegerer/phpstan-typo3": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nivek1110\\Extendredirect\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nivek1110\\Extendredirect\\Tests\\": "Tests"
        }
    },
    "replace": {
        "typo3-ter/extendredirect": "self.version"
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
        ]
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build/public",
            "extension-key": "extendredirect",
            "version": "1.2.1",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
