#!/bin/bash
## Description: Give this git worktree a unique DDEV name so it can run alongside other worktrees
## Usage: worktree-init [name]
## Example: "ddev worktree-init" (derives name from the branch) or "ddev worktree-init extendredirect-foo"

set -e

APPROOT="${DDEV_APPROOT:-$PWD}"
TARGET="${APPROOT}/.ddev/config.local.yaml"

# Pick a project name: explicit arg wins, else extendredirect-<branch>, else extendredirect-<dir>.
if [ -n "$1" ]; then
    NAME="$1"
else
    BRANCH="$(git -C "${APPROOT}" branch --show-current 2>/dev/null || true)"
    SUFFIX="${BRANCH:-$(basename "${APPROOT}")}"
    NAME="extendredirect-${SUFFIX}"
fi
# Sanitize to a valid DDEV project name (lowercase alnum + hyphen).
NAME="$(printf '%s' "${NAME}" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"

if [ "${NAME}" = "extendredirect" ]; then
    echo "Refusing to use the base name 'extendredirect' — that collides with the main checkout."
    echo "Run this inside a worktree, or pass an explicit name: ddev worktree-init <name>"
    exit 1
fi

# override_config makes additional_hostnames REPLACE (not merge with) the base list,
# so this worktree claims only its own v13./v14. hosts. The nginx server blocks match
# v13.*/v14.* by regex, and the v13/v14 Docker volumes are ${DDEV_SITENAME}-scoped, so
# both isolate automatically once the name differs.
cat > "${TARGET}" <<YAML
# Generated by 'ddev worktree-init'. Gitignored; unique per worktree.
name: ${NAME}
override_config: true
additional_hostnames:
    - v13.${NAME}
    - v14.${NAME}
YAML

echo "Wrote ${TARGET}"
echo "  project name : ${NAME}"
echo "  default      : https://${NAME}.ddev.site/"
echo "  v13 / v14    : https://v13.${NAME}.ddev.site/  https://v14.${NAME}.ddev.site/"
echo ""
echo "Next: ddev restart   then   ddev demo / ddev install-v13 / ddev install-v14"
